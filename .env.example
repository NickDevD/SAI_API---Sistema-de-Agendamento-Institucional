# =========================
# DATABASE CONFIG
# =========================
POSTGRES_DB_NAME=agendamento_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# =========================
# DEFAULT USER (DEV ONLY)
# =========================
# Criado automaticamente no boot pelo AdminSetup.java (senha em texto puro,
# encriptada em runtime - nao precisa gerar hash manualmente)
ADMIN_LOGIN_LINE=admin
ADMIN_PASSWORD_LINE=admin123

# =========================
# SECURITY
# =========================
JWT_SECRET=your_jwt_secret_here

# =========================
# FRONTEND
# =========================
VITE_API_URL=http://localhost:8080

# ==========================================
# DEMO / PORTFOLIO (nao use em instalacao real)
# ==========================================
# Quando true, popula a base com atendimentos ficticios (se estiver vazia)
# e cria o usuario demo com role USER.
DEMO_SEED_ENABLED=false
DEMO_LOGIN=demo
DEMO_PASSWORD=defina_uma_senha_demo

# Credenciais do demo exibidas na tela de login (lidas pelo NAVEGADOR no build).
# Deixe vazias em instalacao real - o aviso so aparece se as duas estiverem definidas.
VITE_DEMO_LOGIN=
VITE_DEMO_PASSWORD=
# Intervalo de reposicao dos dados de demo quando a base fica vazia (ms)
DEMO_RESEED_INTERVAL_MS=300000
