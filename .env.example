# =========================
# DATABASE CONFIG
# =========================
POSTGRES_DB_NAME=agendamento_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# =========================
# DEFAULT USER (DEV ONLY)
# =========================
# DEFAULT_USER_PASSWORD e so uma referencia: o hash abaixo (ADMIN_PASSWORD_HASH)
# ja corresponde a essa senha em texto puro (util/GenerateHash.java gera o hash).
DEFAULT_USER_PASSWORD=admin123

# Usados pela migration Flyway V3 (insert do usuario admin inicial)
FLYWAY_PLACEHOLDERS_ADMIN_LOGIN=admin
# IMPORTANTE: hash bcrypt tem "$" literais. Dentro de um arquivo .env lido pelo
# Docker Compose, escreva cada "$" como "$$" (senao o Compose tenta interpretar
# pedacos do hash como variaveis e corrompe o valor). O hash abaixo ja esta
# escapado; ao gerar um novo com GenerateHash.java, dobre os "$" antes de colar aqui.
FLYWAY_PLACEHOLDERS_ADMIN_PASSWORD_HASH=$$2a$$10$$oSXZD.WHPDZdYJ8M68lkv.bc3B1QB9v.tueuaKPv8u9HWz6nIxGjG

# =========================
# SECURITY
# =========================
JWT_SECRET=your_jwt_secret_here

# =========================
# FRONTEND
# =========================
VITE_API_BASE_URL=http://localhost:8080/api/v1